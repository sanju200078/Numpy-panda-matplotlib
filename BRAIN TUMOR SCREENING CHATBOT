import torch
import torch.nn as nn
import torch.optim as optim
import torchvision.transforms as transforms
import torchvision.datasets as datasets
from torch.utils.data import DataLoader, random_split
from PIL import Image
from google.colab import drive, files
from sklearn.metrics import classification_report

# ---------------------------
# 3. Device Setup
# ---------------------------
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print("Using device:", device)

# ---------------------------
# 4. Mount Google Drive
# ---------------------------
drive.mount('/content/drive')

# ---------------------------
# 5. Dataset Path (EDIT IF NEEDED)
# ---------------------------
DATASET_PATH = "/content/drive/MyDrive/WORKSHOP/Brain-tumor-data-set/archive/brain-tumor-mri-dataset"

# ---------------------------
# 6. Image Transform
# ---------------------------
transform = transforms.Compose([
    transforms.Grayscale(num_output_channels=1),
    transforms.Resize((128, 128)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.5], std=[0.5])
])

# ---------------------------
# 7. Load Dataset from Folder
# ---------------------------
dataset = datasets.ImageFolder(root=DATASET_PATH, transform=transform)
class_names = dataset.classes
print("Classes:", class_names)

# ---------------------------
# 8. Train / Val Split
# ---------------------------
train_size = int(0.8 * len(dataset))
val_size = len(dataset) - train_size

train_data, val_data = random_split(dataset, [train_size, val_size])

train_loader = DataLoader(train_data, batch_size=32, shuffle=True)
val_loader = DataLoader(val_data, batch_size=32, shuffle=False)

# ---------------------------
# 9. CNN Model Definition
# ---------------------------
class BrainTumorCNN(nn.Module):
    def __init__(self, num_classes=4):
        super().__init__()
        self.features = nn.Sequential(
            nn.Conv2d(1, 32, 3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2),

            nn.Conv2d(32, 64, 3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2),

            nn.Conv2d(64, 128, 3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2)
        )
        self.classifier = nn.Sequential(
            nn.Linear(128 * 16 * 16, 256),
            nn.ReLU(),
            nn.Dropout(0.5),
            nn.Linear(256, num_classes)
        )

    def forward(self, x):
        x = self.features(x)
        x = x.view(x.size(0), -1)
        return self.classifier(x)

model = BrainTumorCNN(num_classes=len(class_names)).to(device)

# ---------------------------
# 10. Training Setup
# ---------------------------
criterion = nn.CrossEntropyLoss()
optimizer = optim.Adam(model.parameters(), lr=0.0001)

# ---------------------------
# 11. Train CNN
# ---------------------------
EPOCHS = 5

for epoch in range(EPOCHS):
    model.train()
    correct, total = 0, 0

    for images, labels in train_loader:
        images, labels = images.to(device), labels.to(device)

        optimizer.zero_grad()
        outputs = model(images)
        loss = criterion(outputs, labels)
        loss.backward()
        optimizer.step()

        _, predicted = torch.max(outputs, 1)
        total += labels.size(0)
        correct += (predicted == labels).sum().item()

    acc = 100 * correct / total
    print(f"Epoch [{epoch+1}/{EPOCHS}] - Train Accuracy: {acc:.2f}%")

# ---------------------------
# 12. Save Trained Model
# ---------------------------
MODEL_PATH = "/content/brain_tumor_cnn33.pth"
torch.save(model.state_dict(), MODEL_PATH)
print("Model saved at:", MODEL_PATH)

# ---------------------------
# 13. Upload MRI Image for Chatbot
# ---------------------------
print("\n📤 Upload Brain MRI Image (JPG)")
uploaded = files.upload()
image_path = list(uploaded.keys())[0]

image = Image.open(image_path)
image_tensor = transform(image).unsqueeze(0).to(device)

# ---------------------------
# 14. Chatbot – 10 Clinical Questions
# ---------------------------
questions = [
    "1. Do you experience frequent headaches?",
    "2. Do headaches worsen in the morning?",
    "3. Have you experienced seizures?",
    "4. Do you have persistent nausea or vomiting?",
    "5. Have you noticed vision problems?",
    "6. Do you experience difficulty in speech?",
    "7. Have you noticed memory loss or confusion?",
    "8. Do you feel weakness or numbness in limbs?",
    "9. Do you have balance or coordination issues?",
    "10. Have you experienced personality changes?"
]

print("\n🧠 Clinical Screening Chatbot (Yes / No)")
answers = []

for q in questions:
    while True:
        ans = input(q + " : ").lower()
        if ans in ["yes", "no"]:
            answers.append(1 if ans == "yes" else 0)
            break
        else:
            print("Please answer Yes or No")

symptom_score = sum(answers) / len(answers)

# ---------------------------
# 15. CNN Prediction
# ---------------------------
model.eval()
with torch.no_grad():
    outputs = model(image_tensor)
    probs = torch.softmax(outputs, dim=1)
    confidence, predicted_class = torch.max(probs, 1)

cnn_confidence = confidence.item()
predicted_label = class_names[predicted_class.item()]

# ---------------------------
# 16. Final Fusion Decision
# ---------------------------
final_risk = (cnn_confidence + symptom_score) / 2

# ---------------------------
# 17. Output Result
# ---------------------------
print("\n🧠 Brain Tumor Screening Result")
print("--------------------------------")
print("Predicted Class:", predicted_label)
print(f"CNN Confidence: {cnn_confidence:.2f}")
print(f"Symptom Score: {symptom_score:.2f}")
print(f"Final Risk Score: {final_risk:.2f}")

if final_risk < 0.3:
    print("Risk Level: LOW")
elif final_risk < 0.6:
    print("Risk Level: MODERATE")
else:
    print("Risk Level: HIGH")

print("\n⚠ DISCLAIMER")
print("This AI-based system is for screening and research only.")
print("It does NOT replace clinical diagnosis.")

