    "Personality or behavior changes"
]

image_input = gr.Image(type="pil", label="Upload Brain MRI")

question_inputs = [
    gr.Radio(["No", "Yes"], label=q, value="No") for q in questions
]

output_label = gr.Textbox(label="Predicted Tumor Type")
output_risk = gr.Number(label="Final Risk Score")
output_plot = gr.Plot(label="Tumor Probability Chart")

