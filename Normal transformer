import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers
import numpy as np

# ========================
# 3. Set dataset paths
# ========================
train_dir = '/content/drive/MyDrive/catdogclassfy/train'
test_dir = '/content/drive/MyDrive/catdogclassfy/Testing'

# ========================
# 4. Data generators
# ========================
datagen = keras.preprocessing.image.ImageDataGenerator(
    rescale=1./255,
    validation_split=0.2
)

train_set = datagen.flow_from_directory(
    train_dir,
    target_size=(224, 224),
    batch_size=16,
    class_mode='binary',
    subset="training"
)

val_set = datagen.flow_from_directory(
    train_dir,
    target_size=(224, 224),
    batch_size=16,
    class_mode='binary',
    subset="validation"
)

# ========================
# 5. Custom Vision Transformer
# ========================
def create_vit_classifier(
    input_shape=(224, 224, 3),
    patch_size=16,
    projection_dim=64,
    transformer_layers=8,
    num_heads=8,
    mlp_dim=128,
    num_classes=1
):
    inputs = keras.Input(shape=input_shape)

    # Patch creation (conv2d -> flatten patches)
    patches = layers.Conv2D(
        filters=projection_dim,
        kernel_size=patch_size,
        strides=patch_size,
        padding="valid"
    )(inputs)
    patches = layers.Reshape((-1, projection_dim))(patches)

    # Transformer encoder layers
    for _ in range(transformer_layers):
        # LayerNorm
        x1 = layers.LayerNormalization()(patches)
        # Multi-head attention
        attention = layers.MultiHeadAttention(
            num_heads=num_heads, key_dim=projection_dim
        )(x1, x1)
        # Skip connection
        x2 = layers.Add()([attention, patches])
        # Feed-forward
        x3 = layers.LayerNormalization()(x2)
        x3 = layers.Dense(mlp_dim, activation="gelu")(x3)
        x3 = layers.Dense(projection_dim)(x3)
        patches = layers.Add()([x3, x2])

    # Classification head
    representation = layers.GlobalAveragePooling1D()(patches)
    outputs = layers.Dense(num_classes, activation="sigmoid")(representation)

    return keras.Model(inputs=inputs, outputs=outputs, name="ViT_custom")

# Build the model
vit_classifier = create_vit_classifier()

# ========================
# 6. Compile model
# ========================
vit_classifier.compile(
    optimizer=keras.optimizers.Adam(1e-4),
    loss="binary_crossentropy",
    metrics=["accuracy"]
)

# ========================
# 7. Train model
# ========================
history = vit_classifier.fit(
    train_set,
    validation_data=val_set,
    epochs=5
)

# ========================
# 8. Save model
# ========================
vit_classifier.save("/content/drive/MyDrive/catdog_vit_custom.keras")

# ========================
# 9. Predict a single image
# ========================
from tensorflow.keras.preprocessing import image

img_path = "/content/drive/MyDrive/catdogclassfy/Testing/dog/dog.5986.jpg"
img = image.load_img(img_path, target_size=(224, 224))
x = image.img_to_array(img)
x = np.expand_dims(x, axis=0) / 255.0

pred = vit_classifier.predict(x)

if pred[0][0] > 0.5:
    print("The image is a Dog")
else:
    print("The image is a Cat")


